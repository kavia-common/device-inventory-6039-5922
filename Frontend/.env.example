# Environment variables for the Device Inventory Frontend

# Backend API base URL (exact key name required)
# Single source of truth: backend_api_base_url
# Read at build time via process.env.backend_api_base_url. For runtime overrides, you may expose window.__ENV__.backend_api_base_url.
# Example values:
#   http://localhost:5000
#   https://api.example.com
backend_api_base_url=http://localhost:5000
